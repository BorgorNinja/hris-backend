{
	"info": {
		"name": "SenTri Backend — ITEC 116 Final Project",
		"description": "Postman collection for the SenTri community safety incident reporting backend (NestJS + TypeORM + MySQL + JWT). Set the {{base_url}} and {{token}} collection variables before use.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:3000/api" },
		{ "key": "token", "value": "paste-jwt-here" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Juan Resident\",\n  \"email\": \"juan@example.com\",\n  \"password\": \"Password123\"\n}" },
						"url": "{{base_url}}/auth/register",
						"description": "Public. Creates a RESIDENT account and returns a JWT."
					}
				},
				{
					"name": "Login",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@sentri.test\",\n  \"password\": \"Password123\"\n}" },
						"url": "{{base_url}}/auth/login",
						"description": "Public. Returns { access_token }. Copy it into the {{token}} collection variable."
					}
				},
				{
					"name": "Profile (protected)",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/auth/profile",
						"description": "Protected. Requires Authorization: Bearer {{token}}."
					}
				},
				{
					"name": "Change Password (protected)",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"current_password\": \"Password123\",\n  \"new_password\": \"NewPassword123\"\n}" },
						"url": "{{base_url}}/auth/password"
					}
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "List Users (admin/official)",
					"request": { "method": "GET", "url": "{{base_url}}/users" }
				},
				{
					"name": "Get User (admin/official)",
					"request": { "method": "GET", "url": "{{base_url}}/users/1" }
				},
				{
					"name": "Create User (admin)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"full_name\": \"New Official\",\n  \"email\": \"official2@sentri.test\",\n  \"password\": \"Password123\",\n  \"role\": \"official\"\n}" },
						"url": "{{base_url}}/users"
					}
				},
				{
					"name": "Update User (admin)",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"role\": \"official\"\n}" },
						"url": "{{base_url}}/users/3"
					}
				},
				{
					"name": "Delete User (admin)",
					"request": { "method": "DELETE", "url": "{{base_url}}/users/4" }
				}
			]
		},
		{
			"name": "Zones",
			"item": [
				{ "name": "List Zones", "request": { "method": "GET", "url": "{{base_url}}/zones" } },
				{ "name": "Get Zone", "request": { "method": "GET", "url": "{{base_url}}/zones/1" } },
				{
					"name": "Create Zone (admin/official)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"name\": \"Palico V\",\n  \"description\": \"Barangay Palico V, Imus City\"\n}" },
						"url": "{{base_url}}/zones"
					}
				},
				{
					"name": "Update Zone (admin/official)",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated description\"\n}" },
						"url": "{{base_url}}/zones/1"
					}
				},
				{ "name": "Delete Zone (admin)", "request": { "method": "DELETE", "url": "{{base_url}}/zones/4" } }
			]
		},
		{
			"name": "Incidents",
			"item": [
				{ "name": "List Incidents", "request": { "method": "GET", "url": "{{base_url}}/incidents", "description": "Residents only see their own reports." } },
				{
					"name": "List Incidents (filtered)",
					"request": { "method": "GET", "url": "{{base_url}}/incidents?status=reported&severity=high&zone_id=1" }
				},
				{ "name": "Get Incident", "request": { "method": "GET", "url": "{{base_url}}/incidents/1" } },
				{ "name": "My Incidents", "request": { "method": "GET", "url": "{{base_url}}/incidents/my" } },
				{ "name": "Incident Stats (admin/official)", "request": { "method": "GET", "url": "{{base_url}}/incidents/stats" } },
				{
					"name": "Create Incident",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"title\": \"Suspicious person at gate\",\n  \"description\": \"Unknown individual loitering near the subdivision gate late at night.\",\n  \"category\": \"suspicious_activity\",\n  \"location\": \"Gate 2, Palico IV\",\n  \"severity\": \"high\",\n  \"latitude\": 14.4234,\n  \"longitude\": 120.9402,\n  \"zone_id\": 1\n}" },
						"url": "{{base_url}}/incidents"
					}
				},
				{
					"name": "Update Incident",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"status\": \"verified\"\n}" },
						"url": "{{base_url}}/incidents/1",
						"description": "Status changes are limited to admin/official."
					}
				},
				{ "name": "Delete Incident", "request": { "method": "DELETE", "url": "{{base_url}}/incidents/1" } }
			]
		},
		{
			"name": "Announcements",
			"item": [
				{ "name": "List Announcements", "request": { "method": "GET", "url": "{{base_url}}/announcements" } },
				{ "name": "List Published Only", "request": { "method": "GET", "url": "{{base_url}}/announcements?published_only=true" } },
				{ "name": "Get Announcement", "request": { "method": "GET", "url": "{{base_url}}/announcements/1" } },
				{
					"name": "Create Announcement (admin/official)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"title\": \"Community safety briefing\",\n  \"body\": \"Monthly safety briefing this Saturday at the barangay hall, 2 PM.\"\n}" },
						"url": "{{base_url}}/announcements"
					}
				},
				{
					"name": "Update Announcement (admin/official)",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"is_published\": true\n}" },
						"url": "{{base_url}}/announcements/1"
					}
				},
				{ "name": "Delete Announcement (admin/official)", "request": { "method": "DELETE", "url": "{{base_url}}/announcements/1" } }
			]
		}
	]
}
